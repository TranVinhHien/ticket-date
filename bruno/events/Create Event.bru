meta {
  name: Create Event
  type: http
  seq: 1
}

post {
  url: {{event_direct_url}}/api/v1/events
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "organizer_id": "{{organizer_id}}",
    "venue_id": "{{venue_id}}",
    "name": "Summer Sonic Music Festival 2027",
    "slug": "summer-sonic-music-festival-2027",
    "description": "The largest outdoor international music festival in Vietnam",
    "poster_url": "https://example.com/poster-summer-sonic.jpg",
    "start_at": "2026-08-15T16:00:00Z",
    "end_at": "2026-08-15T23:30:00Z",
    "status": "PUBLISHED",
    "ticket_types": [
      {
        "sku": "SS27-VIP-ZONEA",
        "name": "VIP Standing Zone A",
        "description": "Front stage access and welcome drink",
        "price": 2500000,
        "currency": "VND",
        "max_per_order": 4,
        "sale_start_at": "2026-06-01T09:00:00Z",
        "sale_end_at": "2026-08-14T23:59:59Z",
        "attributes": {
          "zone": "A",
          "fast_track": true
        },
        "status": "ACTIVE"
      },
      {
        "sku": "SS27-GA",
        "name": "General Admission",
        "description": "Standard festival entry",
        "price": 800000,
        "currency": "VND",
        "max_per_order": 6,
        "sale_start_at": "2026-06-01T09:00:00Z",
        "sale_end_at": "2026-08-14T23:59:59Z",
        "attributes": {
          "zone": "GA"
        },
        "status": "ACTIVE"
      }
    ]
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.data && body.data.id) {
    bru.setVar("event_id", body.data.id);
    bru.setVar("event_slug", body.data.slug);
    console.log("Saved event_id:", body.data.id);
    console.log("Saved event_slug:", body.data.slug);
    if (body.data.ticket_types && body.data.ticket_types.length > 0) {
      bru.setVar("ticket_type_id", body.data.ticket_types[0].id);
      console.log("Saved ticket_type_id:", body.data.ticket_types[0].id);
    }
  }
}
