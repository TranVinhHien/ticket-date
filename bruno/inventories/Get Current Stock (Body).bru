meta {
  name: Get Current Stock (Body)
  type: http
  seq: 4
}

post {
  url: {{inventory_direct_url}}/api/v1/inventories/stock
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "ticket_type_ids": [
      "{{ticket_type_id}}"
    ]
  }
}
