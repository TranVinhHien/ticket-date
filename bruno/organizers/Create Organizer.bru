meta {
  name: Create Organizer
  type: http
  seq: 1
}

post {
  url: {{event_direct_url}}/api/v1/organizers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "organization_name": "LiveNation Vietnam",
    "description": "Leading entertainment and concert promoter in Vietnam",
    "logo_url": "https://example.com/logo.png",
    "tax_code": "0109988776",
    "address": "123 Nguyen Hue, District 1, Ho Chi Minh City",
    "status": "ACTIVE"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.data && body.data.id) {
    bru.setVar("organizer_id", body.data.id);
    console.log("Saved organizer_id:", body.data.id);
  }
}
